# NTTT Environment Variables

# Firebase Configuration (Base64 encoded JSON)
# Copy from tangotiempo.com/.env.local - same Firebase project
# Login is universal across all apps
NEXT_PUBLIC_FIREBASE_JSON=

# App ID (for tracking only)
# 1=tangotiempo, 2=harmonyjunction, 3=NTTT, 4=TangoDJ
NEXT_PUBLIC_APPLICATION_ID=3
