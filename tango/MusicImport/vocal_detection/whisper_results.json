  {
    "songID": "e39eab85-49d1-5ba6-8c52-1cc18bdb862d",
    "hasSinger": true,
    "vocalSegments": [
      {
        "start": 65.1,
        "end": 70.1,
        "duration": 5.0,
        "text": "El farol de una cantina la neblina del riachuelo,"
      },
      {
        "start": 70.1,
        "end": 73.7,
        "duration": 3.7,
        "text": "que ha atendido bajo el cielo como un palido tel\u00f3n"
      },
      {
        "start": 74.1,
        "end": 77.7,
        "duration": 3.7,
        "text": "Tien la mesa de presos y pesas sin con suelo,"
      },
      {
        "start": 78.1,
        "end": 81.7,
        "duration": 3.6,
        "text": "Donde yo van y est\u00e1 llorando con la voz de la cord"
      },
      {
        "start": 82.1,
        "end": 86.1,
        "duration": 4.0,
        "text": "Su lejana cantilena se despeina, se asespina,"
      },
      {
        "start": 86.6,
        "end": 89.9,
        "duration": 3.3,
        "text": "Con la dura desventura que las timas invatan,"
      },
      {
        "start": 89.9,
        "end": 94.1,
        "duration": 4.2,
        "text": "El repite que ma\u00f1ana volver\u00e1 a su racacina,"
      },
      {
        "start": 94.6,
        "end": 99.0,
        "duration": 4.4,
        "text": "Maniposa mentirosa remontada sobre el mar,"
      },
      {
        "start": 99.7,
        "end": 107.7,
        "duration": 8.0,
        "text": "Lo manir volver\u00e1 ma\u00f1ana lejar,"
      },
      {
        "start": 108.9,
        "end": 110.8,
        "duration": 1.8,
        "text": "Pensadis ya que pas\u00f3,"
      },
      {
        "start": 112.0,
        "end": 114.9,
        "duration": 2.9,
        "text": "El porerongio van y se repite,"
      },
      {
        "start": 115.4,
        "end": 119.0,
        "duration": 3.6,
        "text": "Que domani, que domani volver\u00e1 la ni\u00f1a buena,"
      },
      {
        "start": 119.0,
        "end": 122.6,
        "duration": 3.6,
        "text": "Y el la copa que envenena,"
      },
      {
        "start": 123.2,
        "end": 127.6,
        "duration": 4.4,
        "text": "Joena siempre van a ma\u00f1ana,"
      },
      {
        "start": 129.2,
        "end": 131.9,
        "duration": 2.7,
        "text": "La mentira del alco."
      },
      {
        "start": 145.3,
        "end": 147.9,
        "duration": 2.6,
        "text": "El porerongio van y se repite,"
      },
      {
        "start": 148.3,
        "end": 152.0,
