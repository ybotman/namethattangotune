      },
      {
        "start": 107.8,
        "end": 110.2,
        "duration": 2.4,
        "text": "Parece lo sobo del mundo,"
      },
      {
        "start": 110.2,
        "end": 113.0,
        "duration": 2.8,
        "text": "Vizando y hage en la campina,"
      },
      {
        "start": 113.4,
