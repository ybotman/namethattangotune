        "text": "Y vez al reat\u00fceno,"
      },
      {
        "start": 115.3,
        "end": 117.7,
        "duration": 2.4,
        "text": "Lo canto feur\u00f3 pa' de girar,"
      },
      {
        "start": 117.7,
        "end": 122.7,
        "duration": 5.0,
        "text": "Se escucha la dulce canci\u00f3n de sorrenzo,"
      },
      {
        "start": 122.9,
        "end": 125.7,
        "duration": 2.8,
        "text": "El lanyo asento de un loco marino,"
      },
      {
        "start": 126.9,
        "end": 128.5,
        "duration": 1.6,
        "text": "Y pasa si el vanto,"
      },
      {
        "start": 128.8,
