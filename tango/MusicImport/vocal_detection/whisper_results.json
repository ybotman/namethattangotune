        "text": "tu t\u00eda legante, la pena de tu angustia,"
      },
      {
        "start": 134.9,
        "end": 138.2,
        "duration": 3.3,
        "text": "de todo su m\u00edo y fue justo al perderte,"
      },
      {
        "start": 138.8,
        "end": 143.3,
        "duration": 4.5,
        "text": "cuando dejaste con tierras de esperallas mi coraz\u00f3"
      },
      {
        "start": 145.6,
        "end": 152.0,
        "duration": 6.4,
        "text": "Se\u00f1or de los sienos y m\u00e1s del d\u00eda amor,"
      },
      {
        "start": 153.0,
        "end": 157.2,
        "duration": 4.2,
        "text": "tan solo aceptino, tan solo perro,"
      },
      {
        "start": 157.4,
        "end": 159.1,
        "duration": 1.7,
        "text": "al hablar y mi dolor."
      },
      {
        "start": 161.1,
        "end": 164.8,
        "duration": 3.7,
        "text": "Se\u00f1or de los sienos,"
      },
      {
        "start": 165.1,
        "end": 166.8,
        "duration": 1.6,
        "text": "un treven mis rocitos,"
      },
      {
        "start": 168.4,
        "end": 171.0,
        "duration": 2.6,
        "text": "y todo perdido,"
      },
      {
        "start": 171.2,
        "end": 172.8,
        "duration": 1.6,
        "text": "y tanto el r\u00edo,"
      },
      {
        "start": 173.2,
        "end": 174.5,
        "duration": 1.4,
        "text": "no quiero vivir."
      }
