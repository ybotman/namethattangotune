        "duration": 2.8,
        "text": "modula mil temidos en derretor,"
      },
      {
        "start": 118.8,
        "end": 124.4,
        "duration": 5.5,
        "text": "en mi penar hab\u00eda en tus ojos los espaciones"
      },
      {
        "start": 124.4,
        "end": 126.8,
        "duration": 2.4,
        "text": "y hab\u00eda en tus enrisas,"
      },
      {
        "start": 126.9,
        "end": 130.7,
        "duration": 3.8,
        "text": "al si asiamar no supe comprenderte,"
      },
      {
        "start": 131.2,
        "end": 134.4,
