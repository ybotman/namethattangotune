  {
    "songID": "d8e1d5a5-c02a-5f32-bebb-7f31e82a53d2",
    "hasSinger": true,
    "vocalSegments": [
      {
        "start": 70.4,
        "end": 75.1,
        "duration": 4.7,
        "text": "\u00a1Pato tero rey del bailongo!"
      },
      {
        "start": 75.7,
        "end": 79.7,
        "duration": 4.0,
        "text": "\u00a1Pato tero sentimental!"
      },
      {
        "start": 80.1,
        "end": 84.0,
        "duration": 3.9,
        "text": "Es contenta con tu risa"
      },
      {
        "start": 84.0,
        "end": 88.0,
        "duration": 4.0,
        "text": "Mucha rara es hora"
      },
      {
        "start": 88.0,
        "end": 90.0,
        "duration": 2.0,
        "text": "Ya lo sab\u00eda"
      },
      {
        "start": 90.0,
        "end": 92.8,
        "duration": 2.8,
        "text": "Yo soy el mar pasando"
      },
      {
        "start": 92.8,
        "end": 97.3,
        "duration": 4.5,
        "text": "Y en mi pejor no entr\u00f3 en querer"
      },
      {
        "start": 97.3,
        "end": 101.8,
        "duration": 4.5,
        "text": "Y en mi vida a tuve moja un chacilla"
      },
      {
        "start": 101.8,
        "end": 105.6,
        "duration": 3.8,
        "text": "Pero nunca una mujer"
      },
      {
        "start": 105.6,
        "end": 111.1,
        "duration": 5.6,
        "text": "Cuando tengo tu palma remate"
      },
      {
        "start": 111.1,
        "end": 115.0,
        "duration": 3.8,
        "text": "Le mi pejor comienza sur ti"
      },
      {
        "start": 115.3,
        "end": 121.6,
        "duration": 6.4,
        "text": "El recuerdo de ella que me quiso de verdad"
      },
      {
        "start": 121.6,
        "end": 124.3,
        "duration": 2.6,
        "text": "Y juingara tu abandoner"
      },
      {
        "start": 124.9,
        "end": 128.4,
        "duration": 3.5,
        "text": "De su amor me parezca impidar"
      },
      {
        "start": 128.4,
        "end": 133.0,
        "duration": 4.6,
        "text": "Que pudiera sentirlo despu\u00e9s"
      },
      {
        "start": 133.0,
        "end": 137.0,
        "duration": 4.0,
        "text": "Sin pensar que los a\u00f1os al correr"
      },
      {
        "start": 137.0,
        "end": 142.3,
        "duration": 5.3,
        "text": "Y van crones amargar a este rey del cabar\u00e9"
      },
      {
        "start": 160.0,
        "end": 161.0,
        "duration": 1.1,
        "text": "Y no hay que ser un marco"
      },
      {
        "start": 161.0,
        "end": 162.5,
        "duration": 1.5,
        "text": "Ya lo sab\u00eda"
      },
      {
        "start": 162.5,
        "end": 164.2,
        "duration": 1.7,
        "text": "Y van a pasar"
      },
      {
        "start": 165.3,
        "end": 169.0,
        "duration": 3.8,
        "text": "Y en mi pejor no entr\u00f3 en querer"
      },
      {
        "start": 169.0,
        "end": 172.9,
        "duration": 3.9,
        "text": "Y en mi vida a tuve moja un chacilla"
      },
      {
        "start": 172.9,
        "end": 176.9,
        "duration": 4.0,
        "text": "Pero nunca una mujer"
      }
    ],
