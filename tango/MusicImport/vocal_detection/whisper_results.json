        "duration": 1.4,
        "text": "Como una armon\u00eda,"
      },
      {
        "start": 130.7,
        "end": 132.3,
        "duration": 1.6,
        "text": "El viento en la plena,"
      },
      {
        "start": 132.6,
        "end": 134.0,
        "duration": 1.4,
        "text": "O a un viejo barreco."
      }
